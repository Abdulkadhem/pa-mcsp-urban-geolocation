{
  "schema_version": 1,
  "experiment_name": "osv5m_urban_pilot_1pct",
  "dataset": {
    "name": "osv5m",
    "source_revision": null,
    "official_train_count": 4894684,
    "official_test_count": 210122,
    "sample_fraction": 0.01,
    "sample_seed": 20260724,
    "sampling_unit": "sequence_id",
    "development_fraction": 0.1,
    "development_seed": 20260725,
    "urban_source": "GHS-SMOD R2023A epoch 2020, 1 km, Mollweide",
    "urban_classes": [21, 22, 23, 30],
